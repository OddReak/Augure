{
  "name": "augure",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@11.24.0 --activate && pnpm install && pnpm exec playwright install --with-deps chromium",
  "forwardPorts": [5173, 4173],
  "portsAttributes": {
    "5173": { "label": "Vite dev" },
    "4173": { "label": "Vite preview" }
  }
}
