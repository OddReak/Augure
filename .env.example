# --- Foreca (côté serveur uniquement, jamais de préfixe VITE_) ---
# direct | rapidapi — sélectionne le module d'authentification utilisé par api/_lib/foreca-auth.ts
FORECA_MODE=direct
# Jeton du portail développeur developer.foreca.com (mode direct)
FORECA_TOKEN=
# Identifiants du portail développeur, alternative au jeton (mode direct)
FORECA_USER=
FORECA_PASSWORD=
# Clé X-RapidAPI-Key du listing « Foreca Weather API » (mode rapidapi)
FORECA_RAPIDAPI_KEY=

# --- Supabase (phase 10, notification quotidienne) ---
# URL du projet, publique côté client
VITE_SUPABASE_URL=
# Clé publishable actuelle (sb_publishable_...), remplace la clé anon dépréciée
VITE_SUPABASE_PUBLISHABLE=
# Clé secrète actuelle (sb_secret_...), remplace service_role, jamais de préfixe VITE_
SUPABASE_SECRET=

# --- Web Push (VAPID) ---
# Clé publique VAPID, exposée au client pour la souscription
VITE_VAPID_PUBLIC=
# Clé privée VAPID, utilisée uniquement par l'Edge Function d'envoi
VAPID_PRIVATE=
# Sujet VAPID au format mailto:, requis par la spec Web Push
VAPID_SUBJECT=
