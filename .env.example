# --- Foreca (côté serveur uniquement, jamais de préfixe VITE_) ---
# direct | rapidapi — sélectionne le module d'authentification utilisé par api/_lib/foreca-auth.ts
FORECA_MODE=direct
# Jeton du portail développeur developer.foreca.com (mode direct)
FORECA_TOKEN=
# Identifiants du portail développeur, alternative au jeton (mode direct)
FORECA_USER=
FORECA_PASSWORD=
# Clé X-RapidAPI-Key du listing « Foreca Weather API » (mode rapidapi)
FORECA_RAPIDAPI_KEY=

# --- Supabase (phase 10, notification quotidienne) ---
# URL du projet, publique côté client
VITE_SUPABASE_URL=
# Clé publishable actuelle (sb_publishable_...), remplace la clé anon dépréciée
VITE_SUPABASE_PUBLISHABLE=
# Clé secrète actuelle (sb_secret_...), remplace service_role, jamais de préfixe VITE_
SUPABASE_SECRET=

# --- Web Push (VAPID) ---
# Clé publique VAPID, exposée au client pour la souscription
VITE_VAPID_PUBLIC=
# Clé privée VAPID, utilisée uniquement par l'Edge Function d'envoi
VAPID_PRIVATE=
# Sujet VAPID au format mailto:, requis par la spec Web Push
VAPID_SUBJECT=

# --- Edge Function « envoi-quotidien » (phase 10) ---
# Ces quatre variables ne sont jamais lues depuis .env : elles vivent dans les secrets
# Supabase (`supabase secrets set …`, ACTIONS.md), pas dans Vercel — recopiées ici pour
# que la liste complète des identifiants du projet reste à un seul endroit.
# URL de base de l'application déployée (Vercel) : l'Edge Function y appelle /api/current,
# /api/hourly, /api/daily — même cache CDN, même quota que le client, jamais un second
# fournisseur (§9).
APP_BASE_URL=
# Sujet et clé privée VAPID, tels que servis par VITE_VAPID_PUBLIC/VAPID_PRIVATE ci-dessus —
# recopiés dans les secrets Supabase, pas une seconde paire de clés.
# 1 : l'Edge Function répond contre les fixtures Cestas (src/mocks/fixtures/cestas.ts) et
# simule l'envoi Push, sans réseau ni vraie souscription — jamais défini en production.
ENVOI_MOCK=

# --- Développement (phase 3) ---
# 1 : fait tourner l'application entièrement contre les fixtures Foreca (src/mocks), sans réseau.
# Absente du tableau du §2 du document maître (ajoutée, voir DECISIONS.md) : ce n'est pas un secret,
# juste un interrupteur de développement, à ne jamais définir en production.
VITE_MOCK=
